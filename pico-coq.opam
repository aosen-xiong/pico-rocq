opam-version: "2.0"
synopsis: "GAIT and PICO Rocq formalizations"
description: "Generic Abstract Immutability Types (GAIT) and the earlier PICO calculus, formalized in Rocq."
maintainer: ["pico-coq"]
authors: ["pico-coq"]
license: "MIT"
depends: [
  "ocaml" {>= "5.2.1"}
  "coq" {= "9.1.1"}
  "dune" {>= "3.11"}
]
build: [
  ["dune" "build" "@default" "-j" jobs]
]
